#ifndef CREDENTIALS_H
#define CREDENTIALS_H

// Insira o nome da sua rede Wi-Fi (SSID) entre as aspas
const char* WIFI_SSID = "SEU_WIFI_SSID_AQUI";

// Insira a senha da sua rede Wi-Fi entre as aspas
const char* WIFI_PASSWORD = "SUA_SENHA_WIFI_AQUI";

// Insira a sua chave de escrita (Write API Key) do canal do ThingSpeak
const char* THINGSPEAK_API_KEY = "SUA_THINGSPEAK_API_KEY_AQUI";

#endif
